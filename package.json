{
  "name": "bun-youtube-sandbox-tui",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --outfile dist/youtube-sandbox-tui",
    "build:linux": "bun build src/index.tsx --compile --target=bun-linux-x64 --outfile dist/youtube-sandbox-tui-linux",
    "build:mac": "bun build src/index.tsx --compile --target=bun-darwin-arm64 --outfile dist/youtube-sandbox-tui-mac",
    "build:mac-intel": "bun build src/index.tsx --compile --target=bun-darwin-x64 --outfile dist/youtube-sandbox-tui-mac-intel",
    "build:win": "bun build src/index.tsx --compile --target=bun-windows-x64 --outfile dist/youtube-sandbox-tui-win.exe",
    "build:all": "bun run build:linux && bun run build:mac && bun run build:mac-intel && bun run build:win",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "react-devtools-core": "^7.0.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "conf": "^15.1.0",
    "ink": "^7.0.2",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "octokit": "^5.0.5"
  }
}
